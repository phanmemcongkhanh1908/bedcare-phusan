{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BEDCARE",
  "version": "1.0.0",
  "identifier": "vn.hospital.bedcare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BEDCARE — Quản lý Giường bệnh & Phòng bệnh",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:3000 http://localhost:3000"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../installer/bedcare.nsi"
      }
    }
  }
}
