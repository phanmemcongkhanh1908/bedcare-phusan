# PORT: Port HTTP/WebSocket cho server Node.js (mặc định 3000)
PORT=3000

# BEDCARE_DATA_DIR: Thư mục lưu SQLite và bản sao lưu cục bộ (mặc định ./data)
BEDCARE_DATA_DIR=./data

# BEDCARE_AUTH_SECRET: Khóa ký HMAC cho phiên đăng nhập (tự sinh ngẫu nhiên khi deploy miễn phí)
BEDCARE_AUTH_SECRET=CHANGE_THIS_SESSION_SECRET

# BEDCARE_BACKUP_KEY: Khóa mã hóa AES-256-GCM cho file sao lưu .bcare
BEDCARE_BACKUP_KEY=CHANGE_THIS_BACKUP_KEY

# GEMINI_API_KEY & APP_URL (tùy chọn môi trường AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
